# Database PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/candisari_db?schema=public"

# Server backend
PORT=3000

# Ganti dengan secret acak yang kuat dan unik untuk setiap environment.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# URL frontend yang diizinkan / dipakai untuk tautan undangan.
# Sesuaikan dengan port frontend aktual.
FRONTEND_URL=http://localhost:3001

# Cloudinary - isi secara lokal, jangan commit kredensial asli.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SMTP - contoh Gmail; gunakan App Password jika memakai Gmail.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="Kecamatan Candisari <noreply@example.com>"
# Allowed browser origins for local frontend development
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
